<view class="wrong-page">
  <block wx:if="{{(initError ? 1 : 0) === 1}}">
    <view class="empty-state">暂时无法读取错题<button class="retry" bindtap="refresh">重新读取</button></view>
  </block>
  <block wx:else>
    <block wx:if="{{(stage === 'books' ? 1 : stage === 'papers' ? 2 : 0) === 1}}">
      <view class="book-heading">
        <view class="page-title">错题集</view>
        <view class="hint">按练习来源整理，选一本开始复习</view>
      </view>
      <block wx:for="{{groups}}" wx:for-item="item_m" wx:for-index="index_n" wx:key="id">
        <button class="book-card {{item_m.id === 'vocabulary' ? 'vocabulary-card' : ''}}" bindtap="openBook" data-id="{{item_m.id}}">
          <view class="card-top">
            <text class="book-name">{{item_m.name}}</text>
            <text class="arrow">›</text>
          </view>
          <view class="hint">{{item_m.description}}</view>
          <view class="book-count"><text>{{item_m.count}}</text>道错题<block wx:if="{{(item_m.id !== 'vocabulary' ? 1 : 0) === 1}}">
  <text class="paper-total">{{item_m.papers}} 套试卷</text>
</block></view>
        </button>
      </block>
    </block>
    <block wx:elif="{{(stage === 'books' ? 1 : stage === 'papers' ? 2 : 0) === 2}}">
      <view class="book-heading">
        <view class="page-title">{{title}}</view>
        <view class="hint">{{totalPapers}} 套试卷 · {{total}} 道错题</view>
      </view>
      <block wx:if="{{(totalPapers ? 1 : 0) === 1}}">
        <view class="filter">
          <input class="search" value="{{query}}" placeholder="搜索试卷名称或年份" bindinput="input" />
          <picker range="{{years}}" value="{{yearIndex}}" bindchange="year">
            <view class="year-picker">{{years[yearIndex]}} ⌄</view>
          </picker>
        </view>
      </block>
      <block wx:for="{{papers}}" wx:for-item="item_w" wx:for-index="index_x" wx:key="id">
        <button class="paper-card" bindtap="openPaper" data-id="{{item_w.id}}">
          <view class="paper-title">{{item_w.title}}</view>
          <view class="paper-bottom">
            <text><text class="number">{{item_w.count}}</text> 道错题</text>
            <text class="open-hint">查看本卷错题 ›</text>
          </view>
        </button>
      </block>
      <block wx:if="{{(!papers.length ? 1 : 0) === 1}}">
        <view class="empty-state">{{emptyText}}</view>
      </block>
    </block>
    <block wx:else>
      <view class="book-heading">
        <view class="question-title">{{title}}</view>
        <view class="heading-bottom">
          <text class="hint">共 {{total}} 道错题</text>
          <block wx:if="{{(total ? 1 : 0) === 1}}">
            <button class="review-button" bindtap="practice">重做这些错题</button>
          </block>
        </view>
      </view>
      <block wx:if="{{(legacyCount ? 1 : 0) === 1}}">
        <view class="legacy-hint">有 {{legacyCount}} 道历史错题未记录练习来源，先保留在这里。</view>
      </block>
      <view class="question-list">
        <block wx:for="{{questions}}" wx:for-item="item_L0" wx:for-index="index_M0" wx:key="id">
          <button class="question-row" bindtap="open" data-id="{{item_L0.id}}">
            <view class="source">{{item_L0.title}} · 第 {{item_L0.no}} 题</view>
            <view class="preview">{{item_L0.preview}}…</view>
          </button>
        </block>
      </view>
      <block wx:if="{{(!total ? 1 : 0) === 1}}">
        <view class="empty-state">{{emptyText}}</view>
      </block>
      <block wx:else>
        <view class="footer-hint">{{hasMore ? '继续上滑加载更多' : '已显示本组全部错题'}}</view>
      </block>
    </block>
  </block>
</view>
