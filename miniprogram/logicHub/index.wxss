.compare-grid{padding:0 1.875px}
.compare-grid,.compare-grid .compare-entry{display:-webkit-flex;display:flex;-webkit-justify-content:space-between;justify-content:space-between}
.compare-grid .compare-entry{background:#fff;border:.625px solid #e9edef;border-radius:8.75px;color:#222;font-size:16.25px;font-weight:500;margin:0;max-width:none;min-width:0;padding:12.5px 8.75px;width:48.5%}
.compare-grid .compare-entry,.compare-mark{-webkit-align-items:center;align-items:center}
.compare-mark{background:#ff656a;border-radius:50%;color:#fff;display:-webkit-flex;display:flex;font-size:17.5px;font-weight:600;height:34.375px;-webkit-justify-content:center;justify-content:center;margin-left:5px;width:34.375px}
