.search-symbol{border:1.875px solid #aaa;border-radius:50%;height:18.75px;margin-right:3.75px;position:relative;width:18.75px}
.search-symbol::after{background:#aaa;bottom:-4.375px;content:"";height:1.875px;position:absolute;right:-7.5px;-webkit-transform:rotate(45deg);transform:rotate(45deg);width:11.875px}
.collections-row{display:-webkit-flex;display:flex;padding:17.5px 6.25px 16.25px}
.collection-icon{-webkit-align-items:center;align-items:center;border-radius:50%;color:#fff;display:-webkit-flex;display:flex;font-size:39.375px;height:52.5px;-webkit-justify-content:center;justify-content:center;line-height:1;width:52.5px}
.mini-book{border:2.5px solid #fff;border-left-width:5.625px;border-radius:1.875px;font-size:21.875px;height:26.875px;line-height:21.875px;width:23.75px}
.collection-name{color:#333;font-size:16.25px;line-height:1.5;margin-top:6.25px}
.collection-count{color:#999;font-size:13.125px;line-height:1.3}
