page{background:#f6f7fa}
.needs-page{padding:30rpx 24rpx 70rpx}
.needs-title{-webkit-align-items:center;align-items:center;color:#2a3a53;display:-webkit-flex;display:flex;font-size:36rpx;font-weight:600;-webkit-justify-content:space-between;justify-content:space-between}
.needs-title>text{color:#ec9b43;font-size:32rpx;font-weight:500}
.needs-tabs{display:-webkit-flex;display:flex;gap:16rpx;margin:28rpx 0}
.needs-page .needs-tabs>button{background:#edf1f7;border-radius:16rpx;color:#9aa8bc;-webkit-flex:1;flex:1;font-size:25rpx;line-height:1.6;margin:0;max-width:none;min-width:0;padding:14rpx}
.needs-page .needs-tabs>.active{background:#e8f0ff;color:#3b78ff}
.needs-page .needs-word{-webkit-align-items:center;align-items:center;background:#fff;border-radius:20rpx;color:#293b56;display:-webkit-flex;display:flex;font-size:30rpx;font-weight:400;-webkit-justify-content:space-between;justify-content:space-between;line-height:1.5;margin:0;max-width:none;padding:28rpx 25rpx;width:100%}
.needs-state{color:#e79a52;font-size:22rpx}
.needs-state.learned{color:#33aa87}
.needs-empty{color:#a1afc2;font-size:25rpx;line-height:1.9;padding:90rpx 25rpx;text-align:center}
.needs-swipe-row{border-radius:20rpx;margin-bottom:18rpx;max-height:150rpx;opacity:1;overflow:hidden;position:relative;transition:max-height .22s cubic-bezier(.22,.8,.22,1),margin .22s,opacity .18s}
.needs-page .needs-delete{-webkit-align-items:center;align-items:center;background:#f35a67;border-radius:0 20rpx 20rpx 0;bottom:0;color:#fff;display:-webkit-flex;display:flex;font-size:27rpx;font-weight:400;-webkit-justify-content:center;justify-content:center;margin:0;max-width:none;min-width:0;position:absolute;right:0;top:0;width:142rpx}
.needs-page .needs-word{position:relative;transition:-webkit-transform .26s cubic-bezier(.22,.8,.22,1);transition:transform .26s cubic-bezier(.22,.8,.22,1);transition:transform .26s cubic-bezier(.22,.8,.22,1),-webkit-transform .26s cubic-bezier(.22,.8,.22,1);z-index:1}
.needs-page .needs-word.tracking{transition:none}
.needs-swipe-row.removing{margin-bottom:0;max-height:0;opacity:0}
@media (min-width:760px){.needs-page{padding:18.75px 15px 43.75px}
.needs-title{-webkit-align-items:center;align-items:center;color:#2a3a53;display:-webkit-flex;display:flex;font-size:22.5px;font-weight:600;-webkit-justify-content:space-between;justify-content:space-between}
.needs-title>text{color:#ec9b43;font-size:20px;font-weight:500}
.needs-tabs{display:-webkit-flex;display:flex;gap:10px;margin:17.5px 0}
.needs-page .needs-tabs>button{background:#edf1f7;border-radius:10px;color:#9aa8bc;-webkit-flex:1;flex:1;font-size:15.625px;line-height:1.6;margin:0;max-width:none;min-width:0;padding:8.75px}
.needs-page .needs-word{-webkit-align-items:center;align-items:center;background:#fff;border-radius:12.5px;color:#293b56;display:-webkit-flex;display:flex;font-size:18.75px;font-weight:400;-webkit-justify-content:space-between;justify-content:space-between;line-height:1.5;margin:0;max-width:none;padding:17.5px 15.625px;width:100%}
.needs-state{color:#e79a52;font-size:13.75px}
.needs-empty{color:#a1afc2;font-size:15.625px;line-height:1.9;padding:56.25px 15.625px;text-align:center}
.needs-swipe-row{border-radius:12.5px;margin-bottom:11.25px;max-height:93.75px;opacity:1;overflow:hidden;position:relative;transition:max-height .22s cubic-bezier(.22,.8,.22,1),margin .22s,opacity .18s}
.needs-page .needs-delete{-webkit-align-items:center;align-items:center;background:#f35a67;border-radius:0 12.5px 12.5px 0;bottom:0;color:#fff;display:-webkit-flex;display:flex;font-size:16.875px;font-weight:400;-webkit-justify-content:center;justify-content:center;margin:0;max-width:none;min-width:0;position:absolute;right:0;top:0;width:88.75px}
}
@import "/styles/tablet-layout.wxss";
